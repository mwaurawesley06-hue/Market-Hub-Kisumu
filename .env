# MPIDS local environment. Never commit this file.
# The older DB_* spellings still work as fallbacks (see config/config.php).

MPIDS_APP_NAME=MPIDS
APP_TIMEZONE=Africa/Nairobi

SESSION_NAME=MPIDSSESSID

CORS_ORIGIN=*

# Database (XAMPP defaults: root with no password)
MPIDS_DB_HOST=127.0.0.1
MPIDS_DB_PORT=3306
MPIDS_DB_NAME=mpids
MPIDS_DB_USER=root
MPIDS_DB_PASS=

# Infobip SMS gateway. Paste YOUR values from portal.infobip.com
# (Settings -> API keys shows the base URL and the key together).
# Leave either value empty to stay in simulation mode.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=MPIDS
SMS_MAX_RETRIES=3

MPIDS_SHOW_SANDBOX_SECRETS=false

SEED_ADMIN_NAME=MPIDS Administrator
SEED_ADMIN_EMAIL=admin@mpids.co.ke
SEED_ADMIN_PASSWORD=TmpProbe12345678!

# MobileSasa SMS gateway (account.mobilesasa.com -> API -> Tokens)
MOBILESASA_TOKEN=mbs_a0be69af4f2ee50fa3c16c403a57be42741a7d1ae125e0f5333f650d6649848e
